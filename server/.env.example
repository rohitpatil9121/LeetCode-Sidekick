# Copy to server/.env and fill in ONE provider. Never put keys in the extension.

# Which LLM to use: anthropic (default) or groq.
# If only GROQ_API_KEY is set, groq is picked automatically.
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high
ANTHROPIC_EFFORT=medium

# --- Groq (OpenAI-compatible, free tier available) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Server ---
PORT=8787
RATE_LIMIT_PER_MIN=30
# Comma-separated extra CORS origins. chrome-extension:// origins are always allowed.
ALLOWED_ORIGINS=
