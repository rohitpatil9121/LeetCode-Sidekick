# Copy to server/.env and fill in.

# Required. Your Anthropic API key. Never put this in the extension.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults shown.
PORT=8787
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high — medium is a good balance of hint quality vs latency.
ANTHROPIC_EFFORT=medium
RATE_LIMIT_PER_MIN=30

# Optional. Comma-separated extra origins allowed by CORS.
# chrome-extension:// origins are always allowed.
ALLOWED_ORIGINS=
